local function isSurvivor(plr)
    return plr.Team and plr.Team.Name == "Survivors"
end

local function isKiller(plr)
    return plr.Team and plr.Team.Name == "Killer"
end

local function createPlayerESP(plr)
    if plr == player then return end

    local character = plr.Character
    if not character then return end

    if not (isSurvivor(plr) or isKiller(plr)) then
        return
    end

    local color = isKiller(plr)
        and Color3.fromRGB(255, 70, 90)
        or Color3.fromRGB(80, 190, 255)

    local highlight = make("Highlight", {
        Name = "PlayerHighlight",
        Adornee = character,
        FillColor = color,
        OutlineColor = color,
        FillTransparency = 0.78,
        OutlineTransparency = 0.05,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, playerESPFolder)

    local root = character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChildWhichIsA("BasePart")

    if not root then
        highlight:Destroy()
        return
    end

    local bill = make("BillboardGui", {
        Adornee = root,
        Size = UDim2.fromOffset(180, 55),
        StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true,
        MaxDistance = 1000,
    }, playerESPFolder)

    local label = make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = color,
        TextStrokeTransparency = 0.2,
    }, bill)

    playerESP[plr] = {
        highlight = highlight,
        bill = bill,
        label = label,
    }
end

local function rebuildPlayerESP()
    clearPlayerESP()

    if not Values["Enable ESP"] then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        createPlayerESP(plr)
    end
end

local function updatePlayerESP()
    for plr, data in pairs(playerESP) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if not char or not hum or not root then
            data.highlight.Enabled = false
            data.bill.Enabled = false
        else
            data.highlight.Enabled = true

            local lines = {}

            if Values["Show Name"] then
                table.insert(lines, plr.DisplayName)
            end

            if Values["Show Health"] then
                table.insert(lines, string.format(
                    "HP %d/%d",
                    math.floor(hum.Health + 0.5),
                    math.floor(hum.MaxHealth + 0.5)
                ))
            end

            if Values["Show Distance"] then
                local myRoot = player.Character
                    and player.Character:FindFirstChild("HumanoidRootPart")

                if myRoot then
                    table.insert(lines, string.format(
                        "%dm",
                        math.floor((myRoot.Position - root.Position).Magnitude + 0.5)
                    ))
                end
            end

            data.label.Text = table.concat(lines, "  ")
            data.bill.Enabled = #lines > 0
        end
    end
end

