local pages = {}
local tabButtons = {}
local allRows = {}

local function showTab(name)

	closePopup()

	for tabName, page in pairs(pages) do
		page.Visible = tabName == name
	end

	for tabName, button in pairs(tabButtons) do

		button.TextColor3 =
			tabName == name
			and TEXT
			or GRAY
	end

	pageTitle.Text = name
end

