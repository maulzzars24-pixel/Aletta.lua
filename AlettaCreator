--========================================================--
-- UTILITY
--========================================================--

local function disconnectList(name)
	local list = FeatureConnections[name]

	if not list then
		return
	end

	for _, connection in ipairs(list) do
		if connection and connection.Disconnect then
			pcall(function()
				connection:Disconnect()
			end)
		end
	end

	FeatureConnections[name] = nil
end

local function addConnection(name, connection)
	if not connection then
		return
	end

	FeatureConnections[name] = FeatureConnections[name] or {}
	table.insert(FeatureConnections[name], connection)

	return connection
end

local function new(className, properties, parent)
	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		object[property] = value
	end

	object.Parent = parent

	return object
end

local function corner(object, radius)
	new("UICorner", {
		CornerRadius = UDim.new(0, radius)
	}, object)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

--========================================================--
-- FEATURE MANAGER
--========================================================--

local FeatureManager = {}

function FeatureManager:Set(name, enabled)
	enabled = enabled == true

	Values[name] = enabled

	disconnectList(name)

	local hook = Hooks[name]

	if hook then
		local success, err = pcall(function()
			hook(enabled)
		end)

		if not success then
			warn("[Aletta] " .. tostring(name) .. ": " .. tostring(err))
		end
	end
end

function FeatureManager:Get(name)
	return Values[name] == true
end

function FeatureManager:Toggle(name)
	self:Set(name, not self:Get(name))
end

function FeatureManager:Stop(name)
	self:Set(name, false)
end

function FeatureManager:Connect(name, signal, callback)
	if not signal or not signal.Connect then
		return nil
	end

	return addConnection(name, signal:Connect(callback))
end

function FeatureManager:StopAll()
	local names = {}

	for name in pairs(FeatureConnections) do
		table.insert(names, name)
	end

	for _, name in ipairs(names) do
		disconnectList(name)
	end
end

--========================================================--
-- CONTROL TYPES
--========================================================--

local function T(label, default)
	return {
		type = "toggle",
		label = label,
		default = default == true
	}
end

local function I(label, default, placeholder)
	return {
		type = "input",
		label = label,
		default = tostring(default or ""),
		placeholder = placeholder
	}
end

local function D(label, options, default)
	return {
		type = "dropdown",
		label = label,
		options = options,
		default = default
	}
end

local function K(label, default)
	return {
		type = "hotkey",
		label = label,
		default = default
	}
end

local function B(label)
	return {
		type = "button",
		label = label
	}
end

local function L(text, height)
	return {
		type = "label",
		label = text,
		height = height
	}
end

local function S(label, min, max, default)
	return {
		type = "slider",
		label = label,
		min = min,
		max = max,
		default = default
	}
end

local function C(label, name)
	local default = "Default " .. name

	return D(
		label,
		{
			default,
			"Red",
			"Green",
			"Blue",
			"Purple",
			"White",
			"Yellow",
			"Orange"
		},
		default
	)
end

local function TC(label, default)
	return D(
		label,
		{
			"Purple",
			"Cyan",
			"Red",
			"Yellow",
			"Orange",
			"Blue",
			"Green",
			"White",
			"Pink"
		},
		default
	)
end

