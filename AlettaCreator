local function makeControl(parent, control, order)

	local frame = new(
		"Frame",
		{
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundTransparency = 1,
			LayoutOrder = order
		},
		parent
	)

	Controls[control.label] =
		Controls[control.label] or {}

	local function commit(value)

		Values[control.label] = value

		local hook = Hooks[control.label]

		if hook then

			task.spawn(function()

				local success, err =
					pcall(hook, value)

				if not success then
					warn(
						"[Aletta] "
						.. control.label
						.. ": "
						.. tostring(err)
					)
				end
			end)
		end
	end

	if control.type ~= "button"
		and control.type ~= "label"
		and control.type ~= "slider"
	then

		new(
			"TextLabel",
			{
				Text = "   " .. control.label,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = Color3.fromRGB(
					220,
					220,
					220
				),
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -118, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true
			},
			frame
		)
	end

	--====================================================--
	-- TOGGLE
	--====================================================--

	if control.type == "toggle" then

		local state =
			control.default == true

		Values[control.label] = state

		local switch = new(
			"TextButton",
			{
				Text = "",
				Size = UDim2.fromOffset(40, 20),
				Position = UDim2.new(
					1,
					-52,
					0.5,
					-10
				),
				AutoButtonColor = false,
				BackgroundColor3 =
					state
					and ACCENT
					or OFF
			},
			frame
		)

		corner(switch, 10)

		local knob = new(
			"Frame",
			{
				Size = UDim2.fromOffset(16, 16),
				Position =
					state
					and UDim2.fromOffset(22, 2)
					or UDim2.fromOffset(2, 2),

				BackgroundColor3 = TEXT
			},
			switch
		)

		corner(knob, 8)

		local function setState(value, runHook)

			state = value == true

			TweenService:Create(
				switch,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 =
						state
						and ACCENT
						or OFF
				}
			):Play()

			TweenService:Create(
				knob,
				TweenInfo.new(0.15),
				{
					Position =
						state
						and UDim2.fromOffset(22, 2)
						or UDim2.fromOffset(2, 2)
				}
			):Play()

			Values[control.label] = state

			if runHook then
				commit(state)
			end
		end

		Controls[control.label].set =
			function(value)
				setState(value, true)
			end

		switch.Activated:Connect(function()
			setState(not state, true)
		end)

	--====================================================--
	-- INPUT
	--====================================================--

	elseif control.type == "input" then

		Values[control.label] =
			tonumber(control.default)
			or control.default

		local box = new(
			"TextBox",
			{
				Text = control.default,
				PlaceholderText =
					control.placeholder or "",

				PlaceholderColor3 =
					Color3.fromRGB(
						140,
						140,
						140
					),

				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = TEXT,
				BackgroundColor3 = FIELD,
				Size = UDim2.fromOffset(96, 26),
				Position = UDim2.new(
					1,
					-106,
					0.5,
					-13
				),
				ClearTextOnFocus = false,
				TextTruncate =
					Enum.TextTruncate.AtEnd
			},
			frame
		)

		corner(box, 6)

		Controls[control.label].set =
			function(value)
				box.Text = tostring(value)
				commit(
					tonumber(value)
					or value
				)
			end

		box.FocusLost:Connect(function()

			commit(
				tonumber(box.Text)
				or box.Text
			)
		end)

	--====================================================--
	-- HOTKEY
	--====================================================--

	elseif control.type == "hotkey" then

		local key =
			Enum.KeyCode[control.default]
			or Enum.KeyCode.Unknown

		Values[control.label] = key

		local button = new(
			"TextButton",
			{
				Text = control.default,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = TEXT,
				BackgroundColor3 = FIELD,
				Size = UDim2.fromOffset(96, 26),
				Position = UDim2.new(
					1,
					-106,
					0.5,
					-13
				)
			},
			frame
		)

		corner(button, 6)

		local listening = false

		button.Activated:Connect(function()

			if listening then
				return
			end

			listening = true
			button.Text = "..."

			local connection

			connection =
				UIS.InputBegan:Connect(
					function(input, gameProcessed)

						if gameProcessed then
							return
						end

						if input.UserInputType
							== Enum.UserInputType.Keyboard
						then

							button.Text =
								input.KeyCode.Name

							commit(
								input.KeyCode
							)

							listening = false

							connection:Disconnect()
						end
					end
				)
		end)

		Controls[control.label].set =
			function(value)

				local keyValue

				if typeof(value)
					== "EnumItem"
				then
					keyValue = value
				else
					keyValue =
						Enum.KeyCode[
							tostring(value)
						]
						or Enum.KeyCode.Unknown
				end

				button.Text =
					keyValue.Name

				commit(keyValue)
			end

	--====================================================--
	-- DROPDOWN
	--====================================================--

	elseif control.type == "dropdown" then

		Values[control.label] =
			control.default

		local button = new(
			"TextButton",
			{
				Text = tostring(control.default),
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = TEXT,
				BackgroundColor3 = FIELD,
				Size = UDim2.fromOffset(96, 26),
				Position = UDim2.new(
					1,
					-106,
					0.5,
					-13
				),
				TextTruncate =
					Enum.TextTruncate.AtEnd
			},
			frame
		)

		corner(button, 6)

		button.Activated:Connect(function()

			openDropdown(
				button,
				control.options,
				Values[control.label],
				function(value)

					button.Text =
						tostring(value)

					commit(value)
				end
			)
		end)

		Controls[control.label].set =
			function(value)

				button.Text =
					tostring(value)

				commit(value)
			end

	--====================================================--
	-- SLIDER
	--====================================================--

	elseif control.type == "slider" then

		frame.Size =
			UDim2.new(
				1,
				0,
				0,
				48
			)

		Values[control.label] =
			control.default

		new(
			"TextLabel",
			{
				Text = "   " .. control.label,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 =
					Color3.fromRGB(
						220,
						220,
						220
					),
				BackgroundTransparency = 1,
				Size =
					UDim2.new(
						1,
						-80,
						0,
						24
					),
				TextXAlignment =
					Enum.TextXAlignment.Left
			},
			frame
		)

		local valueLabel = new(
			"TextLabel",
			{
				Text =
					tostring(control.default)
					.. "/"
					.. tostring(control.max),

				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = GRAY,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(70, 24),
				Position =
					UDim2.new(
						1,
						-78,
						0,
						0
					),
				TextXAlignment =
					Enum.TextXAlignment.Right
			},
			frame
		)

		local track = new(
			"TextButton",
			{
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = FIELD,
				Size =
					UDim2.new(
						1,
						-24,
						0,
						8
					),
				Position =
					UDim2.new(
						0,
						12,
						0,
						32
					)
			},
			frame
		)

		corner(track, 4)

		local fill = new(
			"Frame",
			{
				BackgroundColor3 = ACCENT,
				BorderSizePixel = 0,
				Size =
					UDim2.fromScale(
						(
							control.default
							- control.min
						)
						/
						(
							control.max
							- control.min
						),
						1
					)
			},
			track
		)

		corner(fill, 4)

		local function setValue(
			value,
			runHook
		)

			value =
				math.clamp(
					math.floor(
						tonumber(value)
						or control.default
						+ 0.5
					),
					control.min,
					control.max
				)

			Values[control.label] =
				value

			local alpha =
				(
					value
					- control.min
				)
				/
				(
					control.max
					- control.min
				)

			fill.Size =
				UDim2.fromScale(
					alpha,
					1
				)

			valueLabel.Text =
				tostring(value)
				.. "/"
				.. tostring(control.max)

			if runHook then
				commit(value)
			end
		end

		Controls[control.label].set =
			function(value)
				setValue(value, true)
			end

		local dragging = false

		local function setFromX(x)

			local alpha =
				math.clamp(
					(
						x
						- track.AbsolutePosition.X
					)
					/
					track.AbsoluteSize.X,
					0,
					1
				)

			local value =
				control.min
				+
				alpha
				*
				(
					control.max
					- control.min
				)

			setValue(value, true)
		end

		track.InputBegan:Connect(function(input)

			if isPress(input) then
				dragging = true
				setFromX(input.Position.X)
			end
		end)

		UIS.InputChanged:Connect(function(input)

			if dragging
				and isMove(input)
			then
				setFromX(input.Position.X)
			end
		end)

		UIS.InputEnded:Connect(function(input)

			if isPress(input) then
				dragging = false
			end
		end)

	--====================================================--
	-- BUTTON
	--====================================================--

	elseif control.type == "button" then

		local button = new(
			"TextButton",
			{
				Text = control.label,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = TEXT,
				BackgroundColor3 = FIELD,
				Size =
					UDim2.new(
						1,
						-16,
						0,
						32
					),
				Position =
					UDim2.fromOffset(
						8,
						3
					),
				AutoButtonColor = false
			},
			frame
		)

		corner(button, 6)

		button.Activated:Connect(function()

			local hook =
				Hooks[control.label]

			if hook then
				task.spawn(hook)
			end
		end)

	--====================================================--
	-- LABEL
	--====================================================--

	elseif control.type == "label" then

		frame.Size =
			UDim2.new(
				1,
				0,
				0,
				control.height or 30
			)

		local note = new(
			"TextLabel",
			{
				Text = control.label,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = GRAY,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				TextXAlignment =
					Enum.TextXAlignment.Left,
				TextYAlignment =
					Enum.TextYAlignment.Top,
				TextWrapped = true
			},
			frame
		)

		new(
			"UIPadding",
			{
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
				PaddingTop = UDim.new(0, 6)
			},
			note
		)
	end
end

