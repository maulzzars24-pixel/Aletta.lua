-- collapsible section
local function section(parent, titleText, icon)
    local holder = new("Frame", {
        Size = UDim2.new(1, -4, 0, 44),
        BackgroundTransparency = 1,
    }, parent)

    local head = button(holder, (icon or "") .. "  " .. titleText)
    head.Size = UDim2.new(1, 0, 0, 44)
    head.TextXAlignment = Enum.TextXAlignment.Left
    head.TextSize = 14
    head.TextColor3 = Theme.Text

    local chev = label(head, "⌄", 18, Theme.Muted, Enum.Font.GothamBold)
    chev.TextXAlignment = Enum.TextXAlignment.Center
    chev.Position = UDim2.new(1, -40, 0, 0)
    chev.Size = UDim2.fromOffset(34, 44)

    local items = new("Frame", {
        Position = UDim2.new(0, 0, 0, 48),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, holder)

    local layout = new("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, items)

    local opened = true

    local function refresh()
        if opened then
            local h = layout.AbsoluteContentSize.Y
            items.Size = UDim2.new(1, 0, 0, h)
            holder.Size = UDim2.new(1, -4, 0, 48 + h)
            chev.Text = "⌃"
        else
            items.Size = UDim2.new(1, 0, 0, 0)
            holder.Size = UDim2.new(1, -4, 0, 44)
            chev.Text = "⌄"
        end
    end

    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), refresh)
    head.MouseButton1Click:Connect(function()
        opened = not opened
        refresh()
    end)

    task.defer(refresh)
    return items
end

local function toggle(parent, text, value, callback)
    local b = button(parent, "")
    b.Size = UDim2.new(1, 0, 0, 42)

    local t = label(b, text, 13, Theme.Text)
    t.Position = UDim2.new(0, 14, 0, 0)
    t.Size = UDim2.new(1, -78, 1, 0)

    local track = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(44, 24),
        BackgroundColor3 = Theme.Card2,
        BorderSizePixel = 0,
    }, b)
    corner(track, 12)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 9)

    local state = value == true
    local function set(v)
        state = v
        track.BackgroundColor3 = state and Theme.Accent or Theme.Card2
        knob.Position = state
            and UDim2.new(1, -21, 0.5, 0)
            or UDim2.new(0, 3, 0.5, 0)
        if callback then callback(state) end
    end
    set(state)
    b.MouseButton1Click:Connect(function() set(not state) end)
    return b
end

