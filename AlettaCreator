local function aimPartFor(characterModel)
 local targetMode = Values["Target Aim"] or "Torso"
 if targetMode == "Head" then
  return characterModel:FindFirstChild("Head") or characterModel:FindFirstChild("HumanoidRootPart")
 elseif targetMode == "Legs" then
  return characterModel:FindFirstChild("LeftFoot") or characterModel:FindFirstChild("HumanoidRootPart")
 end
 return characterModel:FindFirstChild("UpperTorso") or characterModel:FindFirstChild("Torso") or characterModel:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(origin, part, targetCharacter)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={character(),targetCharacter}
 local hit=workspace:Raycast(origin,part.Position-origin,params)
 return hit==nil
end

local function getAimTarget()
 if not camera then return nil end
 local myCharacter=character()
 if not myCharacter then return nil end
 local myRoot=root()
 if not myRoot then return nil end
 local maxDistance=tonumber(Values["Pistol FOV Radius"]) or 120
 local maxWorldDistance=80
 local bestPart,bestScore=nil,math.huge
 local targetMode=Values["Pistol Target"] or "Killer"

 for _,plr in ipairs(Players:GetPlayers()) do
  if plr~=player then
   local tc=plr.Character
   local th=tc and tc:FindFirstChildOfClass("Humanoid")
   local tr=tc and tc:FindFirstChild("HumanoidRootPart")
   if tc and th and th.Health>0 and tr then
    local validRole=true
    if targetMode=="Killer" then
     validRole=tc:GetAttribute("Role")=="Killer" or plr:GetAttribute("Role")=="Killer"
    elseif targetMode=="Survivor" then
     validRole=tc:GetAttribute("Role")=="Survivor" or plr:GetAttribute("Role")=="Survivor"
    end
    if validRole then
     local part=aimPartFor(tc)
     local dist=(tr.Position-myRoot.Position).Magnitude
     local screen,onScreen=camera:WorldToViewportPoint(part.Position)
     if onScreen and dist<=maxWorldDistance then
      local center=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
      local score=(Vector2.new(screen.X,screen.Y)-center).Magnitude
      if score<=maxDistance and score<bestScore and hasLineOfSight(camera.CFrame.Position,part,tc) then
       bestScore=score
       bestPart=part
      end
     end
    end
   end
  end
 end
 return bestPart
end

