--========================================================--
-- DRAG
--========================================================--

local function draggable(
	handle,
	target,
	onTap
)

	local dragging = false
	local moved = false

	local startMouse
	local startPosition

	handle.InputBegan:Connect(function(input)

		if not isPress(input) then
			return
		end

		dragging = true
		moved = false

		startMouse = input.Position
		startPosition = target.Position

		input.Changed:Connect(function()

			if input.UserInputState
				== Enum.UserInputState.End
			then

				dragging = false

				if not moved and onTap then
					onTap()
				end
			end
		end)
	end)

	UIS.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if not isMove(input) then
			return
		end

		local delta =
			input.Position
			- startMouse

		if delta.Magnitude > 6 then
			moved = true
		end

		if moved then

			target.Position =
				UDim2.fromOffset(
					startPosition.X.Offset
						+ delta.X,

					startPosition.Y.Offset
						+ delta.Y
				)
		end
	end)
end

--========================================================--
-- MINIMIZE / RESTORE
--========================================================--

local function minimize()

	closePopup()

	openButton.Position =
		window.Position

	window.Visible = false
	openButton.Visible = true
end

local function restore()

	window.Position =
		openButton.Position

	openButton.Visible = false
	window.Visible = true
end

minBtn.Activated:Connect(minimize)

openButton.Activated:Connect(function()
	restore()
end)

draggable(top, window)

draggable(
	openButton,
	openButton,
	function()
		restore()
	end
)

--========================================================--
-- CHARACTER
--========================================================--

local function character()
	return player.Character
end

local function humanoid()

	local c = character()

	return c
		and c:FindFirstChildOfClass(
			"Humanoid"
		)
end

local function root()

	local c = character()

	return c
		and c:FindFirstChild(
			"HumanoidRootPart"
		)
end

