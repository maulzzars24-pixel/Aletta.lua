--==================================================

local function nearestObject(list)
    local best, bestDistance

    for _, obj in ipairs(list) do
        local d = objectDistance(obj)

        if d and (not bestDistance or d < bestDistance) then
            best = obj
            bestDistance = d
        end
    end

    return best, bestDistance
end

local function findNearestGeneratorPrompt()
    local objects = getMapObjects()
    local nearest, nearestDistance, nearestPrompt

    for _, generator in ipairs(objects.generators) do
        local d = objectDistance(generator)

        if d and (not nearestDistance or d < nearestDistance) then
            local prompt = generator:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

            if prompt then
                nearest = generator
                nearestDistance = d
                nearestPrompt = prompt
            end
        end
    end

    return nearest, nearestDistance, nearestPrompt
end

Hooks["Auto Generator Test"] = function(on)
    if not on then return end

    FeatureManager:Connect(
        "Auto Generator Test",
        RunService.Heartbeat,
        function()
            -- Inspection only. No forced remote invocation.
            local generator, distance, prompt = findNearestGeneratorPrompt()

            if generator and prompt and distance
                and distance <= prompt.MaxActivationDistance then

                if not prompt.Enabled then
                    return
                end
            end
        end
    )
end

--==================================================
