		PaddingRight = UDim.new(0, 6)
	},
	popup
)

local popupOwner

local function closePopup()
	popup.Visible = false
	popupOwner = nil
end

local function openDropdown(owner, options, current, callback)

	if popup.Visible and popupOwner == owner then
		closePopup()
		return
	end

	for _, child in ipairs(popup:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, option in ipairs(options) do

		local button = new(
			"TextButton",
			{
				Text = "  " .. tostring(option),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 =
					option == current
					and TEXT
					or GRAY,

				TextXAlignment = Enum.TextXAlignment.Left,

				BackgroundColor3 = ACCENT,

				BackgroundTransparency =
					option == current
					and 0.6
					or 1,

				Size = UDim2.new(1, -4, 0, 30),

				ZIndex = 51
			},
			popup
		)

		corner(button, 6)

		button.Activated:Connect(function()
			callback(option)
			closePopup()
		end)
	end

	local height = math.min(
		#options * 32 + 12,
		190
	)

	local relative =
		owner.AbsolutePosition
		- window.AbsolutePosition

	local x = math.clamp(
		relative.X + owner.AbsoluteSize.X - 150,
		8,
		window.AbsoluteSize.X - 158
	)

	local y =
		relative.Y
		+ owner.AbsoluteSize.Y
		+ 2

	if y + height > window.AbsoluteSize.Y - 4 then
		y = relative.Y - height - 2
	end

	popup.Position =
		UDim2.fromOffset(
			x,
			math.max(y, 44)
		)

	popup.Size =
		UDim2.fromOffset(
			150,
			height
		)

	popup.CanvasPosition = Vector2.zero
	popupOwner = owner
	popup.Visible = true
end

