--==================================================
-- AUTOMATION / COMBAT TRAINING (SERVER-SAFE)
--==================================================
-- Uses the real VD RemoteEvent names only for observation. It does NOT
-- forge FireServer calls or bypass server validation. Aim/prediction is
-- client-side and the M2/skill-check controls are local developer tests.

do
    local page = pages["Automation"]

    addTitle(page, "AUTOMATION • VD", "Functional developer/test helpers based on the remotes found in ViolenceDistrictVD.rbxlx.")

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Camera = workspace.CurrentCamera
    local predictedMarker
    local combatConn
    local skillConn
    local parryConn
    local lastCombatEvent = 0

    local function remote(path)
        local node = ReplicatedStorage
        for part in string.gmatch(path, "[^/]+") do
            node = node:FindFirstChild(part)
            if not node then return nil end
        end
        return node
    end

    local function getRoot(plr)
        local c = plr and plr.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function targetFor(range)
        local myRoot = getRoot(player)
        if not myRoot then return nil end
        local best, bestD = nil, range or 250
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local r = getRoot(plr)
                local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if r and hum and hum.Health > 0 then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < bestD then best, bestD = plr, d end
                end
            end
        end
        return best, bestD
    end

    local function predictedPosition(plr, lead)
        local r = getRoot(plr)
        if not r then return nil end
        local v = r.AssemblyLinearVelocity
        return r.Position + v * (lead or 0.12)
    end

    local function setMarker(pos, enabled)
        if not predictedMarker then
            predictedMarker = Instance.new("Part")
            predictedMarker.Name = "AlettaPredictionMarker"
            predictedMarker.Shape = Enum.PartType.Ball
            predictedMarker.Size = Vector3.new(1.1,1.1,1.1)
            predictedMarker.Anchored = true
            predictedMarker.CanCollide = false
            predictedMarker.CanQuery = false
            predictedMarker.CanTouch = false
            predictedMarker.Material = Enum.Material.Neon
            predictedMarker.Color = COLORS.purple
            predictedMarker.Parent = workspace
        end
        predictedMarker.Transparency = enabled and 0.15 or 1
        if enabled and pos then predictedMarker.Position = pos end
    end

    local function aimAt(plr, lead)
        if not Camera then Camera = workspace.CurrentCamera end
        local pos = predictedPosition(plr, lead)
        if not pos then return end
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, pos)
    end

    addToggle(page, "Pistol Aim + Prediction", false, function(on)
        if on then
            combatConn = RunService.RenderStepped:Connect(function()
                local plr = targetFor(300)
                if plr then
                    local pos = predictedPosition(plr, 0.12)
                    setMarker(pos, true)
                    if Values["Pistol Aim + Prediction"] then
                        aimAt(plr, 0.12)
                    end
                else
                    setMarker(nil, false)
                end
            end)
        else
            if combatConn then combatConn:Disconnect(); combatConn=nil end
            setMarker(nil, false)
        end
    end)

    addToggle(page, "Killer Veil Aim", false, function(on)
        if on then
            if not combatConn then
                combatConn = RunService.RenderStepped:Connect(function()
                    local plr = targetFor(350)
                    if plr then
                        local pos = predictedPosition(plr, 0.18)
                        setMarker(pos, true)
                        if Values["Killer Veil Aim"] then aimAt(plr, 0.18) end
                    end
                end)
            end
        end
    end)

    addToggle(page, "Skill Check Detector", true, function(on)
        if skillConn then skillConn:Disconnect(); skillConn=nil end
        local ev = remote("Remotes/Generator/SkillCheckEvent")
        if on and ev and ev:IsA("RemoteEvent") then
            skillConn = ev.OnClientEvent:Connect(function(...)
                lastCombatEvent = os.clock()
                print("[Aletta] SkillCheckEvent detected", ...)
            end)
        end
    end)

    addToggle(page, "Parry Timing Trainer", false, function(on)
        if parryConn then parryConn:Disconnect(); parryConn=nil end
        local ev = remote("Remotes/Items/Parrying Dagger/parryResult")
        if on and ev and ev:IsA("RemoteEvent") then
            parryConn = ev.OnClientEvent:Connect(function(...)
                lastCombatEvent = os.clock()
                print("[Aletta] Parry result detected", ...)
            end)
        end
    end)

    addButton(page, "Target Nearest Survivor/Killer", function()
        local plr, d = targetFor(500)
        if plr then
            aimAt(plr, 0.12)
            print(string.format("[Aletta] Target: %s (%.1f studs)", plr.Name, d or -1))
        else
            warn("[Aletta] Tidak ada target valid.")
        end
    end)

    addButton(page, "Test Hidden M2 Input", function()
        local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
        if tool then
            local name = string.lower(tool.Name)
            if string.find(name, "m2") or string.find(name, "hidden") then
                tool:Activate()
                print("[Aletta] Local tool Activate() dipanggil: " .. tool.Name)
            else
                print("[Aletta] Tool aktif bukan Hidden/M2: " .. tool.Name)
            end
        else
            warn("[Aletta] Tidak ada Tool yang sedang dipakai.")
        end
    end)

    addLabel(page, "Detected VD remotes: Generator.SkillCheckEvent, Generator.SkillCheckResultEvent, Generator.SkillCheckFailEvent, Generator.RepairEvent, Attacks.BasicAttack, Attacks.Lunge, Killers.Hidden.M2, Killers.Hidden.m2HitVM, Killers.Veil.Spearthrow, Killers.Veil.visualize, Killers.Veil.vfx, Items.Parrying Dagger.parry, Items.Parrying Dagger.parryResult.", COLORS.green)
    addLabel(page, "Catatan: parameter server untuk remote tersebut tidak lengkap pada dump (sebagian script mengalami decompilation panic), jadi script ini tidak mengarang payload remote.", COLORS.yellow)
end

