    if not on then return end

    FeatureManager:Connect("Aim Assist", RunService.RenderStepped, function()
        local camera = workspace.CurrentCamera
        local target = getAimTarget()

        if camera and target then
            local current = camera.CFrame
            local wanted = CFrame.lookAt(
                current.Position,
                target.Position
            )

            camera.CFrame = current:Lerp(wanted, 0.08)
        end
    end)
end

