local function getMap()
    return workspace:FindFirstChild("Map")
end

local function getWorldPosition(obj)
    if not obj then return nil end

    if obj:IsA("Model") then
        local pp = obj.PrimaryPart
        if pp then return pp.Position end

        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end

    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function getAdornee(obj)
    if not obj then return nil end

    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    elseif obj:IsA("BasePart") then
        return obj
    end

    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function objectDistance(obj)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pos = getWorldPosition(obj)

    if not root or not pos then return nil end
    return (root.Position - pos).Magnitude
end

local function getMapObjects()
    local map = getMap()

    local result = {
        map = map,
        generators = {},
        hooks = {},
        pallets = {},
        gates = {},
        escapeParts = {},
    }

    if not map then return result end

    local generatorFolder = map:FindFirstChild("Generator")
    if generatorFolder then
        for _, obj in ipairs(generatorFolder:GetChildren()) do
            if obj.Name == "Generator" then
                table.insert(result.generators, obj)
            end
        end
    end

    for _, obj in ipairs(map:GetChildren()) do
        if obj.Name == "Hook" then
            table.insert(result.hooks, obj)
        elseif obj.Name == "Pallet" then
            table.insert(result.pallets, obj)
        elseif obj.Name == "Gate" then
            table.insert(result.gates, obj)
        end
    end

    for _, obj in ipairs(map:GetDescendants()) do
        if obj.Name == "EscapePart" or obj.Name == "gatespot" then
            table.insert(result.escapeParts, obj)
        end
    end

    return result
end

