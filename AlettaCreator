local popupOwner=nil
local function closePopup() popup.Visible=false popupOwner=nil end
local function openDropdown(owner,options,current,onPick)
 if popup.Visible and popupOwner==owner then closePopup() return end
 for _,c in ipairs(popup:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
 for _,opt in ipairs(options) do
  local b=new("TextButton",{Text="  "..opt,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=(opt==current) and TEXT or GRAY,TextXAlignment=Enum.TextXAlignment.Left,BackgroundColor3=ACCENT,BackgroundTransparency=(opt==current) and .6 or 1,Size=UDim2.new(1,-4,0,30),ZIndex=21},popup)
  corner(b,6)
  b.Activated:Connect(function() onPick(opt);closePopup() end)
 end
 local h=math.min(#options*32+12,190)
 local rel=owner.AbsolutePosition-window.AbsolutePosition
 local x=math.clamp(rel.X+owner.AbsoluteSize.X-150,8,window.AbsoluteSize.X-158)
 local y=rel.Y+owner.AbsoluteSize.Y+2
 if y+h>window.AbsoluteSize.Y-4 then y=rel.Y-h-2 end
 popup.Position=UDim2.fromOffset(x,math.max(y,44))
 popup.Size=UDim2.fromOffset(150,h)
 popup.CanvasPosition=Vector2.zero
 popupOwner=owner
 popup.Visible=true
end

