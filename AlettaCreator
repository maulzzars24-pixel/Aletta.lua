local function slider(parent, text, min, max, initial, callback, displayMode)
    local holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 68),
        BackgroundColor3 = Theme.Card,
        BorderSizePixel = 0,
    }, parent)
    corner(holder, 8)

    local title = label(holder, text, 12, Theme.Text)
    title.Position = UDim2.new(0, 14, 0, 7)
    title.Size = UDim2.new(0.65, 0, 0, 20)

    local val = label(holder, "", 12, Theme.Accent2, Enum.Font.GothamBold)
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Position = UDim2.new(0.65, 0, 0, 7)
    val.Size = UDim2.new(0.3, -10, 0, 20)

    local bar = new("Frame", {
        Position = UDim2.new(0, 14, 0, 40),
        Size = UDim2.new(1, -28, 0, 7),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
    }, holder)
    corner(bar, 4)

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 4)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(17, 17),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
    }, bar)
    corner(knob, 9)

    local dragging = false
    local current = initial

    local function setFromX(x)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        current = math.floor(min + (max - min) * alpha + 0.5)
        local a = (current - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        if displayMode == false then
            val.Text = ""
        else
            val.Text = tostring(current) .. (displayMode or "")
        end
        if callback then callback(current) end
    end

    setFromX(bar.AbsolutePosition.X + bar.AbsoluteSize.X * ((initial-min)/(max-min)))

    connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return holder
end

local function action(parent, text, callback)
