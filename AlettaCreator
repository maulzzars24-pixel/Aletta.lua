local function makeControl(parent,c,order,page)
 local f=new("Frame",{Size=UDim2.new(1,0,0,38),BackgroundTransparency=1,LayoutOrder=order},parent)
 Controls[c.label]=Controls[c.label] or {}

 if c.type~="button" and c.type~="label" and c.type~="slider" then
  new("TextLabel",{Text="   "..c.label,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(220,220,220),BackgroundTransparency=1,Size=UDim2.new(1,-118,1,0),TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true},f)
 end

 local function commit(v)
  Values[c.label]=v
  if Hooks[c.label] then
   task.spawn(function()
    local ok,err=pcall(Hooks[c.label],v)
    if not ok then warn("[Aletta] "..c.label..": "..tostring(err)) end
   end)
  end
 end

 if c.type=="toggle" then
  local state=c.default==true
  Values[c.label]=state
  local sw=new("TextButton",{Text="",Size=UDim2.fromOffset(40,20),Position=UDim2.new(1,-52,.5,-10),AutoButtonColor=false,BackgroundColor3=state and ACCENT or OFF},f)
  corner(sw,10)
  local knob=new("Frame",{Size=UDim2.fromOffset(16,16),Position=state and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2),BackgroundColor3=TEXT},sw)
  corner(knob,8)
  local function setState(v,runHook)
   state=v==true
   TweenService:Create(sw,TweenInfo.new(.15),{BackgroundColor3=state and ACCENT or OFF}):Play()
   TweenService:Create(knob,TweenInfo.new(.15),{Position=state and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2)}):Play()
   Values[c.label]=state
   if runHook then commit(state) end
  end
  Controls[c.label].set=function(v) setState(v,true) end
  sw.Activated:Connect(function() setState(not state,true) end)

 elseif c.type=="input" then
  Values[c.label]=tonumber(c.default) or c.default
  local box=new("TextBox",{Text=c.default,PlaceholderText=c.placeholder or "",PlaceholderColor3=Color3.fromRGB(140,140,140),Font=Enum.Font.GothamBold,TextSize=12,TextColor3=TEXT,BackgroundColor3=FIELD,Size=UDim2.fromOffset(96,26),Position=UDim2.new(1,-106,.5,-13),ClearTextOnFocus=false,TextTruncate=Enum.TextTruncate.AtEnd},f)
  corner(box,6)
  Controls[c.label].set=function(v) box.Text=tostring(v);commit(tonumber(v) or v) end
  box.FocusLost:Connect(function() commit(tonumber(box.Text) or box.Text) end)

 elseif c.type=="hotkey" then
  local key=Enum.KeyCode[c.default] or Enum.KeyCode.Unknown
  Values[c.label]=key
  local btn=new("TextButton",{Text=c.default,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=TEXT,BackgroundColor3=FIELD,Size=UDim2.fromOffset(96,26),Position=UDim2.new(1,-106,.5,-13)},f)
  corner(btn,6)
  local listening=false
  btn.Activated:Connect(function()
   if listening then return end
   listening=true;btn.Text="..."
   local conn
   conn=UIS.InputBegan:Connect(function(input,gp)
    if gp then return end
    if input.UserInputType==Enum.UserInputType.Keyboard then
     btn.Text=input.KeyCode.Name
     commit(input.KeyCode)
     listening=false
     conn:Disconnect()
    end
   end)
  end)
  Controls[c.label].set=function(v)
   local k=typeof(v)=="EnumItem" and v or Enum.KeyCode[tostring(v)] or Enum.KeyCode.Unknown
   btn.Text=k.Name;commit(k)
  end

 elseif c.type=="dropdown" then
  Values[c.label]=c.default
  local btn=new("TextButton",{Text=c.default,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=TEXT,BackgroundColor3=FIELD,Size=UDim2.fromOffset(96,26),Position=UDim2.new(1,-106,.5,-13),TextTruncate=Enum.TextTruncate.AtEnd},f)
  corner(btn,6)
  btn.Activated:Connect(function() openDropdown(btn,c.options,Values[c.label],function(v) btn.Text=v;commit(v) end) end)
  Controls[c.label].set=function(v) btn.Text=tostring(v);commit(v) end

 elseif c.type=="slider" then
  f.Size=UDim2.new(1,0,0,48)
  Values[c.label]=c.default
  new("TextLabel",{Text="   "..c.label,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(220,220,220),BackgroundTransparency=1,Size=UDim2.new(1,-80,0,24),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},f)
  local val=new("TextLabel",{Text=c.default.."/"..c.max,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=GRAY,BackgroundTransparency=1,Size=UDim2.fromOffset(70,24),Position=UDim2.new(1,-78,0,0),TextXAlignment=Enum.TextXAlignment.Right},f)
  local track=new("TextButton",{Text="",AutoButtonColor=false,BackgroundColor3=FIELD,Size=UDim2.new(1,-24,0,8),Position=UDim2.new(0,12,0,32)},f)
  corner(track,4)
  local fill=new("Frame",{BackgroundColor3=ACCENT,BorderSizePixel=0,Size=UDim2.fromScale((c.default-c.min)/(c.max-c.min),1)},track)
  corner(fill,4)
  local function setValue(v,runHook)
   v=math.clamp(math.floor(tonumber(v) or c.default+.5),c.min,c.max)
   Values[c.label]=v
   fill.Size=UDim2.fromScale((v-c.min)/(c.max-c.min),1)
   val.Text=v.."/"..c.max
   if runHook then commit(v) end
  end
  Controls[c.label].set=function(v) setValue(v,true) end
  local dragging=false
  local function setFromX(x) setValue(c.min+(math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1))*(c.max-c.min),true) end
  track.InputBegan:Connect(function(input)
   if isPress(input) then
    dragging=true;setFromX(input.Position.X)
   end
  end)
  UIS.InputChanged:Connect(function(input)
   if dragging and isMove(input) then setFromX(input.Position.X) end
  end)
  UIS.InputEnded:Connect(function(input) if isPress(input) then dragging=false end end)

 elseif c.type=="button" then
  local btn=new("TextButton",{Text=c.label,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=TEXT,BackgroundColor3=FIELD,Size=UDim2.new(1,-16,0,32),Position=UDim2.fromOffset(8,3)},f)
  corner(btn,6)
