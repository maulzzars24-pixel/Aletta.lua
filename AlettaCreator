local espDirty = true

local ESP_CONFIG = {
    Generator = {
        color = Color3.fromRGB(80, 210, 255),
        enabledName = "ESP Generator",
    },
    Pallet = {
        color = Color3.fromRGB(255, 175, 80),
        enabledName = "ESP Pallet",
    },
    Hook = {
        color = Color3.fromRGB(255, 80, 105),
        enabledName = "ESP Hook",
    },
    Gate = {
        color = Color3.fromRGB(120, 255, 140),
        enabledName = "ESP Gate",
    },
}

local function clearESP()
    for _, item in pairs(espObjects) do
        if item and item.container then
            item.container:Destroy()
        end
    end
    table.clear(espObjects)
end

local function addESPObject(obj, kind)
    if not obj or not obj.Parent then return end

    local config = ESP_CONFIG[kind]
    if not config or not Values[config.enabledName] then return end

    local adornee = getAdornee(obj)
    if not adornee then return end
    if espObjects[obj] then return end

    local container = make("Folder", {
        Name = "ESP_" .. kind,
    }, espFolder)

    local highlight = make("Highlight", {
        Name = "Highlight",
        Adornee = obj:IsA("Model") and obj or adornee,
        FillColor = config.color,
        OutlineColor = config.color,
        FillTransparency = 0.72,
        OutlineTransparency = 0.08,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, container)

    local bill = make("BillboardGui", {
        Name = "Info",
        Adornee = adornee,
        Size = UDim2.fromOffset(170, 48),
        StudsOffset = Vector3.new(0, 2.8, 0),
        AlwaysOnTop = true,
        MaxDistance = 1000,
        Enabled = Values["Show Name"] or Values["Show Distance"],
    }, container)

    local label = make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = config.color,
        TextStrokeTransparency = 0.25,
        Text = obj.Name,
    }, bill)

    espObjects[obj] = {
        container = container,
        highlight = highlight,
        billboard = bill,
        label = label,
        object = obj,
    }
end

local function rebuildESP()
    clearESP()

    local objects = getMapObjects()

    for _, obj in ipairs(objects.generators) do
        addESPObject(obj, "Generator")
    end

    for _, obj in ipairs(objects.pallets) do
        addESPObject(obj, "Pallet")
    end

    for _, obj in ipairs(objects.hooks) do
        addESPObject(obj, "Hook")
    end

    for _, obj in ipairs(objects.gates) do
        addESPObject(obj, "Gate")
    end

    espDirty = false
end

local function updateESPLabels()
    for obj, data in pairs(espObjects) do
        if not obj or not obj.Parent then
            if data.container then data.container:Destroy() end
            espObjects[obj] = nil
        else
            local lines = {}

            if Values["Show Name"] then
                table.insert(lines, data.object.Name)
            end

            if Values["Show Distance"] then
                local d = objectDistance(data.object)
                if d then
                    table.insert(lines, string.format("%dm", math.floor(d + 0.5)))
                end
            end

            data.label.Text = table.concat(lines, "  ")
            data.billboard.Enabled = #lines > 0
        end
    end
end

Hooks["Enable ESP"] = function(on)
    if not on then
        clearESP()
        return
    end

    rebuildESP()

    local elapsed = 0
    FeatureManager:Connect("Enable ESP", RunService.Heartbeat, function(dt)
        elapsed += dt

        if espDirty and elapsed >= 0.25 then
            elapsed = 0
            rebuildESP()
        elseif elapsed >= 0.15 then
            elapsed = 0
            updateESPLabels()
        end
    end)
end

local function markESPDirty()
    espDirty = true
end

