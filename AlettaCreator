local FeatureConnections = {}
local Hooks = {}
local Controls = {}

local function disconnectList(name)
    local list = FeatureConnections[name]
    if not list then return end

    for _, connection in ipairs(list) do
        if connection and connection.Disconnect then
            pcall(function() connection:Disconnect() end)
        end
    end

    FeatureConnections[name] = nil
end

local FeatureManager = {}

function FeatureManager:Connect(name, signal, callback)
    if not signal or not signal.Connect then return nil end

    FeatureConnections[name] = FeatureConnections[name] or {}
    local connection = signal:Connect(callback)
    table.insert(FeatureConnections[name], connection)
    return connection
end

function FeatureManager:Set(name, enabled)
    enabled = enabled == true
    Values[name] = enabled
    disconnectList(name)

    local hook = Hooks[name]
    if hook then
        local ok, err = pcall(hook, enabled)
        if not ok then
            warn("[Aletta] " .. name .. ": " .. tostring(err))
        end
    end
end

function FeatureManager:Get(name)
    return Values[name] == true
end

function FeatureManager:Stop(name)
    disconnectList(name)
end

function FeatureManager:StopAll()
    local names = {}
    for name in pairs(FeatureConnections) do
        table.insert(names, name)
    end
    for _, name in ipairs(names) do
        disconnectList(name)
    end
end

