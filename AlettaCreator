UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if Values["Open Keybind"] ~= false and input.KeyCode == (Values["Menu Bind"] or Enum.KeyCode.RightShift) then
        if Values["Lock GUI"] == true then
            -- Lock GUI only blocks dragging; menu bind still works.
        end
        window.Visible = not window.Visible
        icon.Visible = true
        closePopup()
        return
    end

    for hotkeyName, featureName in pairs(hotkeyMap) do
        local key = Values[hotkeyName]

        if typeof(key) == "EnumItem" and key == input.KeyCode then
            if Values[featureName] ~= nil then
                FeatureManager:Toggle(featureName)
            end
        end
    end
end)

