-- =========================================================

local AimLock = {
    target = nil
}

_G.AlettaAimLock = AimLock

local function aimPartFor(characterModel)
    local targetMode = Values["Target Aim"] or "Torso"

    if targetMode == "Head" then
        return characterModel:FindFirstChild("Head")
            or characterModel:FindFirstChild("HumanoidRootPart")
    elseif targetMode == "Legs" then
        return characterModel:FindFirstChild("LeftFoot")
            or characterModel:FindFirstChild("HumanoidRootPart")
    end

    return characterModel:FindFirstChild("UpperTorso")
        or characterModel:FindFirstChild("Torso")
        or characterModel:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(origin, part, targetCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character(), targetCharacter}

    local result = workspace:Raycast(
        origin,
        part.Position - origin,
        params
    )

    return result == nil
end

local function getAimTarget()
    camera = workspace.CurrentCamera or camera
    if not camera then return nil end

    local myRoot = root()
    if not myRoot then return nil end

    local maxPixels = tonumber(Values["Pistol FOV Radius"]) or 120
    local maxWorldDistance = 80
    local targetMode = Values["Pistol Target"] or "Killer"

    local bestPart
    local bestScore = math.huge

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local targetCharacter = targetPlayer.Character
            local targetHumanoid = targetCharacter
                and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetCharacter
                and targetCharacter:FindFirstChild("HumanoidRootPart")

            if targetCharacter and targetHumanoid and targetRoot
                and targetHumanoid.Health > 0 then

                local validRole = true
                local role = targetCharacter:GetAttribute("Role")
                    or targetPlayer:GetAttribute("Role")

                if targetMode == "Killer" then
                    validRole = role == "Killer"
                elseif targetMode == "Survivor" then
                    validRole = role == "Survivor"
                elseif targetMode == "Zombie" then
                    validRole = role == "Zombie"
                        or role == "Zombie Dummy"
                        or role == "SCP"
                end

                if validRole then
                    local part = aimPartFor(targetCharacter)

                    if part then
                        local worldDistance =
                            (targetRoot.Position - myRoot.Position).Magnitude

                        local screen, onScreen =
                            camera:WorldToViewportPoint(part.Position)

                        if onScreen and worldDistance <= maxWorldDistance then
                            local center =
                                Vector2.new(
                                    camera.ViewportSize.X / 2,
                                    camera.ViewportSize.Y / 2
                                )

                            local score =
                                (Vector2.new(screen.X, screen.Y) - center).Magnitude

                            if score <= maxPixels
                                and score < bestScore
                                and hasLineOfSight(
                                    camera.CFrame.Position,
                                    part,
                                    targetCharacter
                                ) then

                                bestScore = score
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart
end

Hooks["Aim Lock"] = function(on)
    if on then
        FeatureManager:Connect("Aim Lock", RunService.RenderStepped, function()
            AimLock.target = getAimTarget()
        end)
    else
        AimLock.target = nil
    end
end

function AimLock.GetTarget()
    local target = AimLock.target

    if target and target.Parent then
        local h = target.Parent:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then
            return target
        end
    end

    return nil
end

function AimLock.Clear()
    AimLock.target = nil
end

