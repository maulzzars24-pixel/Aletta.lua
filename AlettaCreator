local function roleOf(targetPlayer)
    local c = targetPlayer.Character

    local role = (c and c:GetAttribute("Role"))
        or targetPlayer:GetAttribute("Role")

    return role and tostring(role) or "Survivor"
end

local function espColor(role)
    local customName

    if role == "Survivor" then
        customName = "Survivor Color"
    elseif role == "Killer" then
        customName = "Killer Color"
    else
        customName = "Zombie Dummy Color"
    end

    local custom = Values[customName]

    local map = {
        Purple = ACCENT,
        Red = Color3.fromRGB(255, 70, 70),
        Green = Color3.fromRGB(70, 255, 100),
        Blue = Color3.fromRGB(70, 140, 255),
        Cyan = Color3.fromRGB(60, 220, 255),
        Yellow = Color3.fromRGB(255, 220, 50),
        Orange = Color3.fromRGB(255, 150, 50),
        White = TEXT
    }

    return map[custom] or espColorMap[role] or ACCENT
end

local function addCharacterESP(targetPlayer)
    if targetPlayer == player then return end

    local c = targetPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local targetRoot = c and c:FindFirstChild("HumanoidRootPart")

    if not c or not h or not targetRoot or h.Health <= 0 then return end

    local role = roleOf(targetPlayer)

    if role == "Killer" and not Values["ESP Killer"] then return end
    if role == "Survivor" and not Values["ESP Survivor"] then return end
    if role ~= "Killer" and role ~= "Survivor"
        and not Values["ESP Zombie Dummy"] then
        return
    end

    local color = espColor(role)

    local highlight = Instance.new("Highlight")
    highlight.Adornee = c
    highlight.FillTransparency = 0.82
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.Parent = espFolder

    if Values["Show Name"]
        or Values["Show Distance"]
        or Values["Show Health"] then

        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = targetRoot
        billboard.Size = UDim2.fromOffset(180, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = espFolder

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 12
        text.TextColor3 = color
        text.TextStrokeTransparency = 0.2
        text.Parent = billboard

        local parts = {}

        if Values["Show Name"] then
            table.insert(parts, targetPlayer.Name)
        end

        if Values["Show Health"] then
            table.insert(parts, "[" .. math.floor(h.Health) .. " HP]")
        end

        if Values["Show Distance"] then
            local myRoot = root()

            if myRoot then
                table.insert(
                    parts,
                    "[" .. math.floor(
                        (myRoot.Position - targetRoot.Position).Magnitude
                    ) .. " M]"
                )
            end
        end

        text.Text = table.concat(parts, " ")
        billboard.Parent = espGui
    end
end

local function objectKind(object)
    local name = object.Name:lower()

    if name:find("generator") then
        return "Generator"
    elseif name:find("gate") or name:find("exit") then
        return "Gate"
    elseif name:find("hook") or name:find("scourge") then
        return "Hook"
    elseif name:find("pallet") then
        return "Pallet"
    end

    return nil
end

local function addObjectESP(object, kind)
    if kind == "Generator" and not Values["ESP Generator"] then return end
    if kind == "Gate" and not Values["ESP Gate"] then return end
    if kind == "Hook" and not Values["ESP Hook"] then return end
    if kind == "Pallet" and not Values["ESP Pallet"] then return end

    local part = object:IsA("BasePart")
        and object
        or object:FindFirstChildWhichIsA("BasePart", true)

    if not part then return end

    local map = {
        Purple = ACCENT,
        Red = Color3.fromRGB(255, 70, 70),
        Green = Color3.fromRGB(70, 255, 100),
        Blue = Color3.fromRGB(70, 140, 255),
        Cyan = Color3.fromRGB(60, 220, 255),
        Yellow = Color3.fromRGB(255, 220, 50),
        Orange = Color3.fromRGB(255, 150, 50),
        White = TEXT,
        Pink = Color3.fromRGB(255, 100, 200)
    }

    local color = map[Values[kind .. " Color"]] or espColorMap[kind]

    local highlight = Instance.new("Highlight")
    highlight.Adornee = object
    highlight.FillTransparency = 0.88
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.Parent = espFolder

    if Values["Show Name"] or Values["Show Distance"] then
        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = part
        billboard.Size = UDim2.fromOffset(150, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = espFolder

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 12
        text.TextColor3 = color
        text.TextStrokeTransparency = 0.2
        text.Parent = billboard

        local displayText = Values["Show Name"] and object.Name or kind
        local myRoot = root()

        if Values["Show Distance"] and myRoot then
            displayText = displayText .. " [" ..
                math.floor((myRoot.Position - part.Position).Magnitude) ..
                " M]"
        end

        text.Text = displayText
        billboard.Parent = espGui
    end
end

local function rebuildESP()
    clearESP()

    if not Values["Enable ESP"] then return end

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        addCharacterESP(targetPlayer)
    end

    for _, object in ipairs(workspace:GetDescendants()) do
        local kind = objectKind(object)

        if kind and (object:IsA("Model") or object:IsA("BasePart")) then
            addObjectESP(object, kind)
        end
    end
end

Hooks["Enable ESP"] = function(on)
    if on then
        rebuildESP()

        local lastRebuild = 0

        FeatureManager:Connect("Enable ESP", RunService.Heartbeat, function()
            local now = os.clock()

            if now - lastRebuild >= 1 then
                lastRebuild = now
                rebuildESP()
            end
        end)
    else
        clearESP()
    end
end

