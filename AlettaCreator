local function toggleRow(name, key)
    local b
    local function refresh()
        b.Text = name .. "  [" .. (state[key] and "ON" or "OFF") .. "]"
        b.BackgroundColor3 = state[key] and Color3.fromRGB(52, 31, 68) or Color3.fromRGB(31, 24, 40)
    end
    b = button("", function()
        state[key] = not state[key]
        refresh()
    end)
    refresh()
    return b
end

local function cycleRow(name, key, values)
    local b
    local index = 1
    for i, v in ipairs(values) do
        if v == state[key] then index = i break end
    end
    local function refresh()
        b.Text = name .. "  [" .. tostring(state[key]) .. "]"
    end
    b = button("", function()
        index = index % #values + 1
        state[key] = values[index]
        refresh()
    end)
    refresh()
    return b
end

local function slider(name, key, minValue, maxValue, step)
    step = step or 1
    local holder = make("Frame", {
        Size = UDim2.new(1, 0, 0, 55),
        BackgroundTransparency = 1,
        ZIndex = 3,
    }, content)
    local txt = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 21),
        BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(235, 225, 245),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    }, holder)
    local bar = make("Frame", {
        Size = UDim2.new(1, 0, 0, 7),
        Position = UDim2.fromOffset(0, 31),
        BackgroundColor3 = Color3.fromRGB(54, 43, 62),
        BorderSizePixel = 0,
        ZIndex = 4,
    }, holder)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, bar)
    local fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = COLORS.Purple,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, bar)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 6,
    }, bar)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

    local dragging = false
    local function setFromX(x)
        local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local raw = minValue + (maxValue - minValue) * pct
        local value = math.floor(raw / step + 0.5) * step
        value = math.clamp(value, minValue, maxValue)
        state[key] = value
        txt.Text = string.format("%s  %s    %s ━━━━━━━━━ %s", name, tostring(value), tostring(minValue), tostring(maxValue))
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    task.defer(function()
        local pct = (state[key] - minValue) / (maxValue - minValue)
        txt.Text = string.format("%s  %s    %s ━━━━━━━━━ %s", name, tostring(state[key]), tostring(minValue), tostring(maxValue))
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
    end)
    return holder
end

local function targetColorRow(targetName)
    local target = state.Targets[targetName]
    local colors = {"Purple","Cyan","Red","Yellow","Orange","Blue","Green","White","Pink","Magenta"}
    local colorIndex = table.find(colors, target.color) or 1
    local b
    local function refresh()
        b.Text = targetName .. "  [" .. (target.enabled and "ON" or "OFF") .. "]  •  " .. target.color
        b.TextColor3 = COLORS[target.color]
    end
    b = button("", function()
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            target.enabled = not target.enabled
        else
            colorIndex = colorIndex % #colors + 1
            target.color = colors[colorIndex]
        end
        refresh()
    end)
    refresh()
    return b
end

