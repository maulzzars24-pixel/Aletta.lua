local function findGeneratorPrompts()
 local out={}
 for _,obj in ipairs(workspace:GetDescendants()) do
  if obj:IsA("ProximityPrompt") then
   local a=obj.Parent and obj.Parent.Parent
   local n=((obj.Name or "").." "..(obj.Parent and obj.Parent.Name or "").." "..(a and a.Name or "")):lower()
   if n:find("generator") or n:find("repair") then table.insert(out,obj) end
  end
 end
 return out
end

Hooks["Bypass Generator"]=function(on)
 if not on then return end
 print("[Aletta] Developer Generator Test enabled")
 -- Uses the project's normal interaction prompt rather than fabricating a remote.
 local prompts=findGeneratorPrompts()
 for _,prompt in ipairs(prompts) do
  pcall(function() prompt:InputHoldBegin() end)
 end
end

