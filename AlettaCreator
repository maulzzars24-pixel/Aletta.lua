local function disconnectList(t, name)
	local list = t[name]
	if not list then return end
	for _, c in ipairs(list) do
		if c and c.Disconnect then pcall(function() c:Disconnect() end) end
	end
	t[name] = nil
end

local function addConnection(name, connection)
	FeatureConnections[name] = FeatureConnections[name] or {}
	table.insert(FeatureConnections[name], connection)
	return connection
end

local FeatureManager = {}

function FeatureManager:Set(name, enabled)
	enabled = enabled == true
	Values[name] = enabled
	disconnectList(FeatureConnections, name)
	local hook = Hooks[name]
	if hook then
		local ok, err = pcall(hook, enabled)
		if not ok then warn("[Aletta] " .. name .. ": " .. tostring(err)) end
	end
end

function FeatureManager:Get(name)
	return Values[name] == true
end

function FeatureManager:Stop(name)
	self:Set(name, false)
end

function FeatureManager:Connect(name, signal, callback)
	if signal and signal.Connect then
		return addConnection(name, signal:Connect(callback))
	end
end

function FeatureManager:StopAll()
	for name in pairs(FeatureConnections) do
		disconnectList(FeatureConnections, name)
	end
end

local function T(label, default) return {type="toggle",label=label,default=default==true} end
local function I(label, default, placeholder) return {type="input",label=label,default=tostring(default or ""),placeholder=placeholder} end
local function D(label, options, default) return {type="dropdown",label=label,options=options,default=default} end
local function K(label, default) return {type="hotkey",label=label,default=default} end
local function B(label) return {type="button",label=label} end
local function L(text,height) return {type="label",label=text,height=height} end
local function S(label,min,max,default) return {type="slider",label=label,min=min,max=max,default=default} end
local function C(label,name)
	local d="Default "..name
	return D(label,{d,"Red","Green","Blue","Purple","White","Yellow","Orange"},d)
end
local function TC(label,default)
	return D(label,{"Purple","Cyan","Red","Yellow","Orange","Blue","Green","White","Pink"},default)
end

