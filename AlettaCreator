local espFolder = make("Folder", {Name = "AlettaESP"}, gui)
local espObjects = {}

local function characterRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function removeESP(instance)
    local item = espObjects[instance]
    if item then
        if item.highlight then item.highlight:Destroy() end
        if item.billboard then item.billboard:Destroy() end
        espObjects[instance] = nil
    end
end

local function addESP(instance, text, colorName)
    if not instance or not instance:IsDescendantOf(workspace) then return end
    local root = characterRoot(instance)
    if not root then return end
    local color = COLORS[colorName] or COLORS.Purple

    local old = espObjects[instance]
    if old then
        old.highlight.FillColor = color
        old.highlight.OutlineColor = color
        old.highlight.FillTransparency = math.clamp(state.ESPTransparency / 11, 0, 1)
        old.highlight.OutlineTransparency = state.ModeOutline and 0 or 1
        old.billboard.Enabled = state.ESPEnabled
        old.billboard.TextLabel.Text = text
        old.billboard.TextLabel.TextColor3 = color
        return
    end

    local h = Instance.new("Highlight")
    h.Name = "AlettaESPHighlight"
    h.Adornee = instance
    h.FillColor = color
    h.OutlineColor = color
    h.FillTransparency = math.clamp(state.ESPTransparency / 11, 0, 1)
    h.OutlineTransparency = state.ModeOutline and 0 or 1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Name = "AlettaESPName"
    bb.Adornee = root
    bb.Size = UDim2.fromOffset(180, 28)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local tl = Instance.new("TextLabel")
    tl.Name = "TextLabel"
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.Text = text
    tl.TextColor3 = color
    tl.TextStrokeTransparency = 0.35
    tl.TextSize = 12
    tl.Font = Enum.Font.GothamBold
    tl.Parent = bb

    espObjects[instance] = {highlight = h, billboard = bb}
end

local function classify(model)
    local n = string.lower(model.Name)
    if n:find("zombie") or n:find("scp") then return "SCP/Zombie" end
    if n:find("killer") or n:find("masked") or n:find("hidden") or n:find("veil") then return "Killer" end
    if n:find("generator") or n:find("gen") then return "Generator" end
    if n:find("pallet") then return "Pallet" end
    if n:find("window") or n:find("vault") then return "Window/Vault" end
    if n:find("hook") then return "Hook" end
    if n:find("gate") or n:find("exit") then return "Exit Gate" end
    if n:find("item") or n:find("flashlight") or n:find("dagger") or n:find("pistol") then return "Item" end
    return nil
end

local function isOtherPlayer(model)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character == model then
            return true
        end
    end
    return false
end

local function updateESP()
    if not state.ESPEnabled then
        for instance in pairs(espObjects) do removeESP(instance) end
        return
    end

    local myRoot = characterRoot(player.Character)
    if not myRoot then return end

    local seen = {}

    if state.Targets.Player.enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local root = characterRoot(p.Character)
                if root and (root.Position - myRoot.Position).Magnitude <= state.ESPDistance then
                    local text = state.NamePlayer and p.Name or "Player"
                    addESP(p.Character, text, state.Targets.Player.color)
                    seen[p.Character] = true
                end
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= player.Character and not isOtherPlayer(obj) then
            local target = classify(obj)
            if target and state.Targets[target] and state.Targets[target].enabled then
                local root = characterRoot(obj)
                if root and (root.Position - myRoot.Position).Magnitude <= state.ESPDistance then
                    addESP(obj, obj.Name, state.Targets[target].color)
                    seen[obj] = true
                end
            elseif state.ESPItem.enabled and classify(obj) == "Item" then
                local root = characterRoot(obj)
                if root and (root.Position - myRoot.Position).Magnitude <= state.ESPDistance then
                    addESP(obj, obj.Name, COLORS.Pink and "Pink" or "Purple")
                    seen[obj] = true
                end
            end
        end
    end

    for instance in pairs(espObjects) do
        if not seen[instance] then removeESP(instance) end
    end
end

local lastESPUpdate = 0
RunService.Heartbeat:Connect(function()
    if os.clock() - lastESPUpdate >= 0.6 then
        lastESPUpdate = os.clock()
        updateESP()
    end
end)

